{
  // Orthanc 配置（backend/orthanc/orthanc.json）
  // 启动方式：docker compose up -d orthanc
  // 文档：https://orthanc.uclouvain.be/book/users/configuration.html

  // ───── 基本信息 ─────────────────────────────────────────
  "Name": "MediScribe-PACS",
  "DicomAet": "MEDISCRIBE",
  "HttpPort": 8042,
  "DicomPort": 4242,
  "DicomCheckCalledAet": false,
  "RemoteAccessAllowed": true,

  // ───── 鉴权（基础认证）─────────────────────────────────
  // 用户名密码不在本文件硬编码——由 docker-compose.yml 的环境变量
  // ORTHANC__REGISTERED_USERS__MEDISCRIBE=${ORTHANC_PASSWORD} 注入。
  // Orthanc 25+ 支持 ENV 覆盖 JSON 配置（_SECTION__KEY 双下划线 = . 分层）。
  // 这样仓库里不留任何能直接登录 Orthanc 的密码。
  "AuthenticationEnabled": true,
  "RegisteredUsers": {},

  // ───── DICOMweb 插件（核心，让 FastAPI/OHIF 走标准协议）─
  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado",
    "Ssl": false,
    "QidoCaseSensitive": false
  },

  // ───── PostgreSQL 索引（复用项目主 PG）──────────────────
  // 文件本身存文件系统（更快），元数据/索引存 PG（便于查询、备份与项目主库一致）
  "PostgreSQL": {
    "EnableIndex": true,
    "EnableStorage": false,
    "Host": "db",
    "Port": 5432,
    "Database": "orthanc",
    // Username / Password 由 docker-compose 注入（ORTHANC__POSTGRESQL__USERNAME /
    // ORTHANC__POSTGRESQL__PASSWORD = ${DB_USER} / ${DB_PASSWORD}），不在本文件硬编码
    "EnableSsl": false,
    "Lock": false,
    // 连接池大小（2026-08-16 上线前体检修正）。
    // 插件 7.0 起该项默认 50，而 Orthanc 会**开机就把 50 条全部建好并常驻**——
    // 实测生产空闲时 pg_stat_activity 里 orthanc 库恒占 50 条 idle 连接，
    // 而 PG 的 max_connections 只有 100。
    // 后端 2 个 uvicorn worker × (pool_size 10 + max_overflow 20) 最高要 60 条，
    // 50 + 60 = 110 > 100 → 满负荷时会撞上 "too many clients already"，
    // 表现为全院接口一起报错（且不是 PACS 报错，是病历接口先挂）。
    // 本院 CT/影像基本不上传，5 条足够（Orthanc 单实例、无并发检索场景）。
    "IndexConnectionsCount": 5
  },

  // ───── 文件存储 ─────────────────────────────────────────
  // /var/lib/orthanc/db 由 docker volume 挂载到宿主机
  "StorageDirectory": "/var/lib/orthanc/db",
  "IndexDirectory": "/var/lib/orthanc/db",

  // ───── CORS ────────────────────────────────────────────
  // ACAO 单源化到 docker-compose 的 ORTHANC__HTTP_HEADERS__* 环境变量
  // （2026-08-29 第八轮审计：此前这里残留 "*" 与 compose 的域名收紧配置
  //  双源冲突——env 覆盖对含连字符键名的转换行为不可靠，可能出现两个
  //  ACAO 头共存。旧值删除，凭 compose 为唯一真源）。
  "HttpHeaders": {
    "Access-Control-Allow-Methods": "GET,POST,PUT,DELETE,OPTIONS",
    "Access-Control-Allow-Headers": "Authorization,Content-Type,Accept,Origin,X-Requested-With"
  },

  // ───── 其他 ─────────────────────────────────────────────
  "ConcurrentJobs": 4,
  "JobsHistorySize": 30,
  "LogLevel": "default"
}
